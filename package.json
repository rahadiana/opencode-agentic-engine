{
  "name": "opencode-agentic-engine",
  "version": "0.1.0",
  "description": "Multi-agent software engineering plugin for OpenCode — implements Stages I-IV from \"The End of Software Engineering\" (arXiv:2606.05608)",
  "type": "module",
  "license": "MIT",
  "author": "rahadiana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahadiana/opencode-agentic-engine.git"
  },
  "bugs": {
    "url": "https://github.com/rahadiana/opencode-agentic-engine/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agent",
    "software-engineering",
    "multi-agent",
    "code-generation",
    "ai"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tool": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node esbuild.config.mjs",
    "dev": "tsc --emitDeclarationOnly --watch & node esbuild.config.mjs --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.3.3",
    "stopword": "^3.1.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  }
}
