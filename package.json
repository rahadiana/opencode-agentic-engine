{
  "name": "opencode-agentic-engine",
  "version": "0.5.6-dev",
  "homepage": "https://github.com/rahadiana/opencode-agentic-engine#readme",
  "engines": {
    "node": ">=20"
  },
  "description": "Multi-agent software engineering plugin for OpenCode — implements Stages I-IV from \"The End of Software Engineering\" (arXiv:2606.05608)",
  "type": "module",
  "license": "MIT",
  "author": "rahadiana nugraha <rahadiana.nugraha@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahadiana/opencode-agentic-engine.git"
  },
  "bugs": {
    "url": "https://github.com/rahadiana/opencode-agentic-engine/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agent",
    "software-engineering",
    "multi-agent",
    "code-generation",
    "ai"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node esbuild.config.mjs",
    "postbuild": "CACHE_DIR=\"$HOME/.cache/opencode/packages/opencode-agentic-engine@latest\"; if [ -d \"$CACHE_DIR\" ]; then cp -r dist/* \"$CACHE_DIR/node_modules/opencode-agentic-engine/dist/\" && cp package.json \"$CACHE_DIR/node_modules/opencode-agentic-engine/package.json\" && (cd \"$CACHE_DIR\" && (npm install better-sqlite3 --no-save --no-fund --no-audit 2>&1 || true)) && echo \"  → copied to opencode cache\"; fi",
    "dev": "concurrently -n types,bundle -c blue,green \"tsc --emitDeclarationOnly --watch\" \"node esbuild.config.mjs --watch\"",
    "dev:simple": "tsc --emitDeclarationOnly --watch & node esbuild.config.mjs --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov --src=src --exclude=\"src/**/domains/**\" node test/run.mjs",
    "test:coverage:ci": "c8 --reporter=text --reporter=lcov --check-coverage --statements=80 --branches=60 --functions=70 --lines=80 --src=src --exclude=\"src/**/domains/**\" node test/run.mjs",
    "test:e2e": "node test/e2e-scenario.mjs",
    "test:e2e-llm": "node test/e2e-llm.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:swebench": "node test/swebench-harness.mjs",
    "test:swebench-llm": "OPENAI_BASE_URL=http://localhost:11434/v1 OPENAI_MODEL=qwen2.5:0.5b node test/swebench-harness.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "stopwords-iso": "^1.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.0",
    "c8": "^11.0.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.25.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.31.0"
  }
}
