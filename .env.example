# LLM Provider
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://your-provider-url/v1
LLM_MODEL=your-model-name

# Model Aliases untuk agentic-engine (optional — fallback ke LLM_MODEL)
# FAST_MODEL digunakan untuk analisis/review (architect, qa, pm)
# CAPABLE_MODEL digunakan untuk implementasi (developer, coordinator)
# FAST_MODEL=StrongReason
# CAPABLE_MODEL=gpt-4o

# OpenCode Web Auth
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=your-password-here

# Telegram (optional — for tunnel URL notification)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
