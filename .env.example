# LLM Provider
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://your-provider-url/v1
LLM_MODEL=your-model-name

# Model Aliases untuk agentic-engine (optional — fallback ke LLM_MODEL)
# FAST_MODEL digunakan untuk analisis/review (architect, qa, pm)
# CAPABLE_MODEL digunakan untuk implementasi (developer, coordinator)
# FAST_MODEL=StrongReason
# CAPABLE_MODEL=gpt-4o

# OpenCode Web Auth
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=your-password-here

# Telegram (optional — for tunnel URL notification)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Embedding / Vector Search ──
# Embedding model untuk vector search di MultiIndexRAG.
# Default: null (TF-IDF only). Set endpoint untuk enable vector search.
#
# Docker (Ollama): http://ollama:11434/v1/embeddings
#   Model: nomic-embed-text (default), all-minilm, mxbai-embed-large
#
# External: https://api.openai.com/v1/embeddings
#   Model: text-embedding-3-small, text-embedding-3-large
EMBEDDING_ENDPOINT=http://ollama:11434/v1/embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
# Override embedding model di Ollama container
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
